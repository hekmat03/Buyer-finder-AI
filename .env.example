# ── Supabase (free tier) ─────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in API routes / server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider (pick one to start; abstraction supports more later) ──
# Mistral has a free tier — recommended default.
MISTRAL_API_KEY=
# Optional alternative provider
GEMINI_API_KEY=
# Which provider the AIProvider factory should use: "mistral" | "gemini" | "mock"
AI_PROVIDER=mock

# ── Search / source providers ────────────────────────────────────
# Reddit's official API (free tier) — used by the Phase-1 source provider.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=buyerfinder-ai/0.1 (by /u/your_username)

# ── Automation ────────────────────────────────────────────────────
# Shared secret required on the header of the Vercel Cron → /api/search/run call,
# so the scheduled endpoint can't be triggered by anyone who finds the URL.
CRON_SECRET=